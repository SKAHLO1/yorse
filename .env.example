# Copy to .env.local (frontend). These are PUBLIC values shipped to the browser.
# No private keys, relayer keys, or AI keys belong here — those live only in backend/.env.

# Firebase web app config (Firebase console > Project settings > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Yorse backend (Express service in /backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: your own Arbitrum Sepolia RPC for wallet reads (defaults to the public RPC)
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=

# WalletConnect (mobile wallets via QR). Get a project ID at https://cloud.reown.com; leave empty to offer browser wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ZeroDev (passkey smart wallets + gas sponsorship). Project ID from dashboard.zerodev.app; leave empty to hide the option.
NEXT_PUBLIC_ZERODEV_PROJECT_ID=
