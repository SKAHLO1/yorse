# Copy to contracts/.env (never commit it). Forge loads it automatically.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Backend relayer key (also deploys + owns the escrow). Needs Arbitrum Sepolia ETH.
RELAYER_PRIVATE_KEY=0x...

# Set after running Deploy.s.sol
ESCROW_ADDRESS=0x...

# Smoke test: any address you control, distinct from the relayer (receives released USDC)
SMOKE_FREELANCER=0x...
# 6-decimal units; 100000 = 0.10 USDC per path (3 paths)
SMOKE_AMOUNT=100000

# Optional, for `forge verify-contract`
ARBISCAN_API_KEY=
