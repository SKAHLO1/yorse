rules_version = '2';

// Yorse: browsers never read or write Firestore directly.
// All data flows through the backend (Firebase Admin SDK bypasses these rules), which
// verifies the user's ID token and scopes every read/write to that user. This keeps
// escrow-critical fields (job status, verdicts, resolutions) server-controlled.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
