# Copy to backend/.env — NEVER commit it. Everything here is server-side only.
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Chain (Arbitrum Sepolia only; the server refuses to start on any other chain) ---
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Relayer key: the ONLY key allowed to call markSubmitted/release/dispute/refund. Needs testnet ETH.
RELAYER_PRIVATE_KEY=0x...
# From `forge script script/Deploy.s.sol` (contracts/)
ESCROW_ADDRESS=0x...

# --- Firebase Admin (Project settings > Service accounts > Generate new private key) ---
# Option A: path to the downloaded JSON (keep it outside the repo or gitignored)
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option B: inline fields (escape newlines in the key as \n)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- AI layer: Groq primary, Gemini fallback (at least one required) ---
GROQ_API_KEY=
# Check available models: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: raises GitHub's anonymous API limit when fetching repo evidence
GITHUB_TOKEN=

# --- Live e2e only (scripts/e2e.ts) ---
# Web API key from Firebase project settings (same as NEXT_PUBLIC_FIREBASE_API_KEY)
FIREBASE_WEB_API_KEY=
# Testnet wallet with Arbitrum Sepolia ETH + USDC (faucet.circle.com); acts as the e2e client
E2E_CLIENT_PRIVATE_KEY=
E2E_API_URL=http://localhost:4000
E2E_AMOUNT=0.10
